# AI_PROVIDER: ollama | openai | azure_openai
AI_PROVIDER=ollama
# 공통 fallback 모델입니다. 정확한 모델명은 환경마다 달라 저장소에 고정하지 않습니다.
AI_MODEL=

# Ollama local: 이 프로젝트의 로컬 모델 아티팩트 운영 기준은 GGUF입니다.
OLLAMA_BASE_URL=http://localhost:11434
# `ollama list`에 표시되는 GGUF 모델명으로 AI_MODEL을 덮어쓸 때만 설정합니다.
OLLAMA_MODEL=

# OpenAI cloud
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=your_deployment_name_here

# Safe public demo mode
# Cloudflare Worker는 runtime-config로 provider와 접근 계정 설정을 다시 확인합니다.
VITE_DEMO_MODE=false
# false이면 Worker runtime-config를 사용할 수 없는 정적 배포에서 AI 요청 UI를 숨깁니다.
VITE_ENABLE_AI_FEATURES=true

# Cloudflare Worker demo access. Production에서는 Worker secret으로만 설정합니다.
# DEMO_SESSION_SECRET은 32자 이상의 무작위 문자열을 사용합니다.
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_SESSION_SECRET=
