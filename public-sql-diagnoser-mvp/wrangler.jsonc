{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sql-diagnoser-demo",
  "compatibility_date": "2026-08-02",
  "main": "./src/cloudflareWorker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
