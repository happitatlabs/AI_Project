CREATE OR REPLACE TRIGGER T_FNDI_ACK
AFTER INSERT OR UPDATE ON IB_ACCTALL_TR_DD_ADD
FOR EACH ROW
BEGIN
    MERGE INTO IB_ACCTALL_TR_DD_LST L
    USING (
        SELECT :NEW.ACCT_SEQ AS ACCT_SEQ,
               :NEW.TR_DATE AS TR_DATE,
               :NEW.TR_DATE_SEQ AS TR_DATE_SEQ,
               :NEW.ACCT_NB AS ACCT_NB,
               :NEW.ACCT_TONGHWA AS ACCT_TONGHWA,
               :NEW.ERP_RCV_FLAG AS ERP_RCV_FLAG,
               :NEW.LAST_UPD_DATE AS LAST_UPD_DATE,
               :NEW.LAST_UPD_TIME AS LAST_UPD_TIME
          FROM DUAL
    ) S
       ON (L.ACCT_SEQ = S.ACCT_SEQ AND L.TR_DATE = S.TR_DATE AND L.TR_DATE_SEQ = S.TR_DATE_SEQ)
    WHEN MATCHED THEN
        UPDATE SET
            L.ERP_RCV_FLAG = S.ERP_RCV_FLAG,
            L.LAST_UPD_DATE = S.LAST_UPD_DATE,
            L.LAST_UPD_TIME = S.LAST_UPD_TIME
    WHEN NOT MATCHED THEN
        INSERT (
            ACCT_SEQ, TR_DATE, TR_DATE_SEQ, ACCT_NB, ACCT_TONGHWA,
            ERP_RCV_FLAG, LAST_UPD_DATE, LAST_UPD_TIME
        ) VALUES (
            S.ACCT_SEQ, S.TR_DATE, S.TR_DATE_SEQ, S.ACCT_NB, S.ACCT_TONGHWA,
            S.ERP_RCV_FLAG, S.LAST_UPD_DATE, S.LAST_UPD_TIME
        );

    UPDATE TN_PAY_ORDER_DTL
       SET ACCT_SEQ = :NEW.ACCT_SEQ,
           TR_DATE = :NEW.TR_DATE,
           TR_DATE_SEQ = :NEW.TR_DATE_SEQ,
           PAY_STAT = CASE WHEN :NEW.ERP_RCV_FLAG = 'Y' THEN 'Y' ELSE PAY_STAT END
     WHERE PAY_DATE = :NEW.PAY_DATE
       AND OUT_ACNT_NOX = :NEW.ACCT_NB;

    IF :NEW.ERP_RCV_FLAG = 'E' OR :NEW.REACT_CD IS NOT NULL THEN
        INSERT INTO TN_IF_RETRY_HIS (
            FILE_DATE, FILE_NUM, FILE_SEQ, TR_DATE, TR_DATE_SEQ, REACT_CD, RETRY_FLAG, ERR_TEXT
        ) VALUES (
            SUBSTR(:NEW.ACCT_SEQ, 1, 8),
            SUBSTR(:NEW.ACCT_SEQ, 9, 6),
            SUBSTR(:NEW.ACCT_SEQ, 15, 6),
            :NEW.TR_DATE,
            :NEW.TR_DATE_SEQ,
            NVL(:NEW.REACT_CD, 'ACKE'),
            'Y',
            'ack mismatch or retry required'
        );
    END IF;
END;
