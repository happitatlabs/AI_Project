CREATE OR REPLACE PROCEDURE P_FUNDIH (
    JOB IN VARCHAR2,
    JACCT_SEQ IN VARCHAR2,
    JTR_DATE IN VARCHAR2,
    JTR_DATE_SEQ IN NUMBER,
    JACCT_NB IN VARCHAR2,
    JACCT_TONGHWA IN VARCHAR2,
    JTR_AMT IN NUMBER,
    JLAST_UPD_DATE IN VARCHAR2,
    JLAST_UPD_TIME IN VARCHAR2
) IS
BEGIN
    IF JOB = 'A' THEN
        INSERT INTO IB_ACCTALL_TR_DD_ADD (
            ACCT_SEQ, TR_DATE, TR_DATE_SEQ, ACCT_NB, ACCT_TONGHWA,
            TR_AMT, CNF_YN, ERP_RCV_FLAG, LAST_UPD_DATE, LAST_UPD_TIME
        ) VALUES (
            JACCT_SEQ, JTR_DATE, JTR_DATE_SEQ, JACCT_NB, JACCT_TONGHWA,
            JTR_AMT, 'N', 'N', JLAST_UPD_DATE, JLAST_UPD_TIME
        );
    ELSIF JOB = 'U' THEN
        UPDATE IB_ACCTALL_TR_DD_ADD
           SET TR_AMT = JTR_AMT,
               LAST_UPD_DATE = JLAST_UPD_DATE,
               LAST_UPD_TIME = JLAST_UPD_TIME
         WHERE ACCT_SEQ = JACCT_SEQ
           AND TR_DATE = JTR_DATE
           AND TR_DATE_SEQ = JTR_DATE_SEQ;
    ELSIF JOB = 'D' THEN
        DELETE FROM IB_ACCTALL_TR_DD_ADD
         WHERE ACCT_SEQ = JACCT_SEQ
           AND TR_DATE = JTR_DATE
           AND TR_DATE_SEQ = JTR_DATE_SEQ;
    END IF;
EXCEPTION
    WHEN OTHERS THEN
        INSERT INTO TN_IF_RETRY_HIS (
            FILE_DATE, FILE_NUM, FILE_SEQ, TR_DATE, TR_DATE_SEQ, REACT_CD, RETRY_FLAG, ERR_TEXT
        ) VALUES (
            '00000000', '000000', '000000', JTR_DATE, JTR_DATE_SEQ, 'ERR1', 'Y', SQLERRM
        );
END;
