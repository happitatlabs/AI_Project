CREATE OR REPLACE TRIGGER T_FNDI_BATCH
BEFORE INSERT OR UPDATE ON IB_BULK_TRAN_ADD
FOR EACH ROW
DECLARE
    WIF_FILE_KEY VARCHAR2(25) := :NEW.FILE_DATE || :NEW.FILE_NUM || :NEW.FILE_SEQ;
BEGIN
    IF INSERTING OR UPDATING THEN
        IF :NEW.TRAN_STATUS = '02' THEN
            :NEW.ERP_RCV_FLAG := NVL(:NEW.ERP_RCV_FLAG, 'N');
        END IF;
        IF WIF_FILE_KEY IS NULL THEN
            RAISE_APPLICATION_ERROR(-20001, 'file key required');
        END IF;
    END IF;
END;
