CREATE OR REPLACE TRIGGER T_FOROUT
BEFORE INSERT OR DELETE ON TN_FOROUT
FOR EACH ROW
BEGIN
    IF INSERTING THEN
        P_FOROUT('A', :NEW.BANK_CD, :NEW.ACNT_NO, :NEW.TR_DATE, :NEW.TR_DATE_SEQ, :NEW.ACCT_SEQ);
    ELSIF DELETING THEN
        P_FOROUT('D', :OLD.BANK_CD, :OLD.ACNT_NO, :OLD.TR_DATE, :OLD.TR_DATE_SEQ, :OLD.ACCT_SEQ);
    END IF;
END;
