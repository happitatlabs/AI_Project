CREATE OR REPLACE TRIGGER T_FOROUD
BEFORE INSERT OR UPDATE OR DELETE ON TN_FOROUD
FOR EACH ROW
BEGIN
    IF INSERTING OR UPDATING THEN
        UPDATE TN_FOROUT
           SET GAP_SUM = NVL(GAP_SUM, 0) + NVL(:NEW.GAP_AMT, 0)
         WHERE BANK_CD = :NEW.BANK_CD
           AND ACNT_NO = :NEW.ACNT_NO
           AND TR_DATE = :NEW.OUT_DATE
           AND TR_DATE_SEQ = :NEW.OUT_DATE_SEQ;

        UPDATE TN_FORINS
           SET RMN_FAMT = RMN_FAMT - NVL(:NEW.OUTF_AMT, 0),
               RMN_AMT = RMN_AMT - NVL(:NEW.OUT_AMT0, 0)
         WHERE TR_DATE = :NEW.IN_DATE
           AND TR_DATE_SEQ = :NEW.IN_DATE_SEQ;
    ELSIF DELETING THEN
        UPDATE TN_FORINS
           SET RMN_FAMT = RMN_FAMT + NVL(:OLD.OUTF_AMT, 0),
               RMN_AMT = RMN_AMT + NVL(:OLD.OUT_AMT0, 0)
         WHERE TR_DATE = :OLD.IN_DATE
           AND TR_DATE_SEQ = :OLD.IN_DATE_SEQ;
    END IF;
END;
