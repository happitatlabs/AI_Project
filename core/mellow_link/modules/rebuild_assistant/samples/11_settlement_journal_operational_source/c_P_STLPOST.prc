CREATE OR REPLACE PROCEDURE P_STLPOST (
    JOB IN VARCHAR2,
    JSTL_DATE IN VARCHAR2,
    JSTL_NO IN NUMBER,
    JAC_DATE IN VARCHAR2,
    JAC_CHITNO IN NUMBER,
    JCURR_CD IN VARCHAR2
) IS
BEGIN
    IF JOB = 'A' THEN
        INSERT INTO TN_BKCHIT (
            AC_DATE, AC_CHITNO, HANG, DC_FLAG, ACNT_CD, CHIT_AMT, TR_DATE, TR_DATE_SEQ, MNEY_UNIT, OCCR_PART, REF_NO
        )
        SELECT JSTL_DATE, JAC_CHITNO, STL_SEQ, DC_FLAG, ACNT_CD, LINE_AMT, JSTL_DATE, JSTL_NO, JCURR_CD, 'SETTLE', REF_NO
          FROM TN_SETTLE_DTL
         WHERE STL_DATE = JSTL_DATE
           AND STL_NO = JSTL_NO;

        INSERT INTO GL_INTERFACE (
            REFERENCE4, REFERENCE6, USER_JE_CATEGORY_NAME, CURRENCY_CODE, ENTERED_DR, ENTERED_CR, STATUS
        )
        SELECT TO_CHAR(JSTL_NO), REF_NO, 'settlement', JCURR_CD,
               CASE WHEN DC_FLAG = '1' THEN LINE_AMT ELSE 0 END,
               CASE WHEN DC_FLAG = '2' THEN LINE_AMT ELSE 0 END,
               'N'
          FROM TN_SETTLE_DTL
         WHERE STL_DATE = JSTL_DATE
           AND STL_NO = JSTL_NO;

        UPDATE TN_BKCHNO
           SET CHK = 'Y'
         WHERE AC_DATE = JAC_DATE
           AND AC_CHITNO = JAC_CHITNO;

        UPDATE TN_PAY_ORDER_DTL
           SET SETTLE_YN = 'Y',
               STL_DATE = JSTL_DATE,
               STL_NO = JSTL_NO,
               AC_DATE = JAC_DATE,
               AC_CHITNO = JAC_CHITNO,
               PAY_STAT = 'S'
         WHERE PAY_DATE = JSTL_DATE
           AND PAY_NO = JSTL_NO;
    ELSIF JOB = 'D' THEN
        UPDATE GL_INTERFACE
           SET STATUS = 'C'
         WHERE REFERENCE4 = TO_CHAR(JSTL_NO);

        DELETE FROM TN_BKCHIT
         WHERE AC_DATE = JAC_DATE
           AND AC_CHITNO = JAC_CHITNO;

        UPDATE TN_BKCHNO
           SET CHK = 'R'
         WHERE AC_DATE = JAC_DATE
           AND AC_CHITNO = JAC_CHITNO;

        UPDATE TN_PAY_ORDER_DTL
           SET SETTLE_YN = 'N',
               PAY_STAT = 'R'
         WHERE STL_DATE = JSTL_DATE
           AND STL_NO = JSTL_NO;
    END IF;
END;
