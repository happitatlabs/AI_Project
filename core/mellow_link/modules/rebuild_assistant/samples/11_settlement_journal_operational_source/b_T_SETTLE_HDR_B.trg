CREATE OR REPLACE TRIGGER T_SETTLE_HDR_B
BEFORE INSERT OR UPDATE ON TN_SETTLE_HDR
FOR EACH ROW
DECLARE
    W_CHITNO NUMBER := 0;
BEGIN
    IF :NEW.CNF_YN = 'Y' AND NVL(:NEW.AC_CHITNO, 0) = 0 THEN
        SELECT NVL(MAX(AC_CHITNO), 0) + 1
          INTO W_CHITNO
          FROM TN_BKCHNO
         WHERE AC_DATE = :NEW.STL_DATE;
        :NEW.AC_DATE := :NEW.STL_DATE;
        :NEW.AC_CHITNO := W_CHITNO;
        INSERT INTO TN_BKCHNO (
            AC_DATE, AC_CHITNO, CHK, OCCR_PART, INVOICE_NO, TR_DATE, TR_DATE_SEQ, CHIT_RMK
        ) VALUES (
            :NEW.STL_DATE, W_CHITNO, '0', 'SETTLE', TO_CHAR(:NEW.STL_NO), :NEW.STL_DATE, :NEW.STL_NO, 'settlement journal'
        );
    END IF;
END;
