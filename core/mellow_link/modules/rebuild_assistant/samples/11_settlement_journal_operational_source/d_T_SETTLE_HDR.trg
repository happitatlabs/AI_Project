CREATE OR REPLACE TRIGGER T_SETTLE_HDR
AFTER INSERT OR UPDATE OR DELETE ON TN_SETTLE_HDR
FOR EACH ROW
BEGIN
    IF INSERTING THEN
        IF :NEW.CNF_YN = 'Y' THEN
            P_STLPOST('A', :NEW.STL_DATE, :NEW.STL_NO, :NEW.AC_DATE, :NEW.AC_CHITNO, :NEW.CURR_CD);
        END IF;
    ELSIF UPDATING THEN
        IF :OLD.CANCEL_YN = 'N' AND :NEW.CANCEL_YN = 'Y' THEN
            P_STLPOST('D', :OLD.STL_DATE, :OLD.STL_NO, :OLD.AC_DATE, :OLD.AC_CHITNO, :OLD.CURR_CD);
        ELSIF :OLD.CNF_YN = 'N' AND :NEW.CNF_YN = 'Y' THEN
            P_STLPOST('A', :NEW.STL_DATE, :NEW.STL_NO, :NEW.AC_DATE, :NEW.AC_CHITNO, :NEW.CURR_CD);
        END IF;
    ELSIF DELETING THEN
        P_STLPOST('D', :OLD.STL_DATE, :OLD.STL_NO, :OLD.AC_DATE, :OLD.AC_CHITNO, :OLD.CURR_CD);
    END IF;
END;
