# --------------------------------------------------------
# 5. 🎨 Open_llm_Vtuber 에셋 관리 (Heavy Assets)
# --------------------------------------------------------
# 배경 이미지 (기본값 제외하고 무시)
/backgrounds/*
!/backgrounds/README.md

# Live2D 모델 (용량 큼, 기본 모델만 허용)
/live2d-models/*
!/live2d-models/mao_pro
!/live2d-models/shizuku
!/live2d-models/haruto

# 캐릭터 설정
/characters/*
!/characters/README.md

# 아바타 이미지
avatars/*

# TTS/ASR 모델 및 캐시 (재다운로드 가능하므로 무시)
cache/*
asset/
src/open_llm_vtuber/tts/asset
src/open_llm_vtuber/tts/config
src/open_llm_vtuber/asr/models*
!src/open_llm_vtuber/asr/models/silero_vad.onnx

# LLM/Voice 모델 가중치
models/*
!models/piper_voice
models/piper_voice/*

